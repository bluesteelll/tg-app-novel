{
  "name": "tg-app-novel-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run story && npm run assets && vite build && node scripts/budget.ts && node scripts/scan-dist.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json --noEmit",
    "assets": "node scripts/assets.ts",
    "story": "node scripts/story.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "sharp": "0.35.5",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
