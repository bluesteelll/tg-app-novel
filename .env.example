# Configuration of `server serve` (parsed by server/src/config.rs). Copy to `.env` (git-ignored) and fill it in.
# Placeholders only - never a real secret. The three placeholder secrets below are refused unless
# TELEGRAM_ENV=test and PUBLIC_APP_URL points at localhost, a loopback address or a .invalid host.

# Bot API token from @BotFather; also the key of the initData HMAC.
BOT_TOKEN=1000000001:placeholder-bot-token-not-a-real-one
# The secret_token given to setWebhook: 1-256 characters of A-Z a-z 0-9 _ -
WEBHOOK_SECRET=placeholder-webhook-secret
# 32 random bytes as 64 hex characters: the MAC key of the session tokens, separate from the bot token.
TOKEN_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Session token lifetime in seconds, 900-3600.
TOKEN_TTL_SECS=1800
# Accepted age of initData's auth_date in seconds, 1-86400.
INITDATA_MAX_AGE_SECS=86400
# The Mini App URL handed to Telegram: https:// in prod; http:// is allowed in the test environment.
PUBLIC_APP_URL=https://example.invalid/
# Comma-separated Telegram user ids allowed to run admin commands; empty = none.
ADMIN_TELEGRAM_IDS=
# The built client to serve (e.g. client/dist); empty = serve no static files.
STATIC_DIR=
# Paid content loaded at startup.
CONTENT_DIR=server/content
# The SQLite database file.
DATABASE_PATH=target/server.db
# prod | test (the Telegram environment, selects the Bot API base).
TELEGRAM_ENV=test
# HTTP listen address.
LISTEN_ADDR=127.0.0.1:8787

# Not read by `server`: the log filter, and the port pair of server-dev and the e2e run.
# RUST_LOG=info
# DEV_API_PORT=8787
# DEV_WEB_PORT=4173
# The PostgreSQL dev cluster of `pgdev`: pg_ctl's directory (default: PATH), its port, its root (default: target/pg).
# PG_BIN=
# DEV_PG_PORT=5487
# DEV_PG_ROOT=
